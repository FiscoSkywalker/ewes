# Copier ce fichier en .env (racine) et/ou apps/api/.env selon l'outil utilisé.
# Ne jamais committer de valeurs réelles — voir blueprint/10_Security.md §4.

# --- PostgreSQL (docker-compose.yml, dev local) ---
# Port 5433 par défaut (et non 5432) pour éviter un conflit si un service
# PostgreSQL natif tourne déjà sur la machine de dev — adapter si besoin.
POSTGRES_USER=ewes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ewes
POSTGRES_PORT=5433

# --- API NestJS (apps/api) ---
DATABASE_URL="postgresql://ewes:change-me@localhost:5433/ewes?schema=public"
PORT=3001
NODE_ENV=development

# JWT — blueprint/10_Security.md §1 (access court, refresh roté et hashé)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

# Compte ADMINISTRATEUR initial créé par `npm run db:seed` (apps/api) — à
# changer avant toute recette/prod ; en attendant la désignation définitive
# par EWES (blueprint/21_Backlog_and_Session_Handoff.md §5).
SEED_ADMIN_EMAIL=admin@ewes.example
SEED_ADMIN_PASSWORD=change-me-now

# Stockage des documents privés — volume disque du VPS (blueprint/11_Document_Management_System.md §6)
PRIVATE_STORAGE_PATH=./storage/private
PUBLIC_MEDIA_PATH=./storage/public

# SMTP — fournisseur à confirmer par EWES (blueprint/21_Backlog_and_Session_Handoff.md §5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EWES <no-reply@ewes.example>"
CONTACT_NOTIFICATION_EMAIL=

# Nombre de proxys de confiance devant l'API : le serveur Next du portail (BFF, qui
# transmet l'adresse et le user-agent du navigateur dans X-Forwarded-For) et, en
# production, Nginx. 1 en développement comme en production. Sans cela, la
# limitation de fréquence (formulaire de contact, connexion, 60 requêtes/min) et
# l'audit verraient l'adresse du serveur pour tous les utilisateurs du portail.
# L'API ne doit alors jamais être joignable autrement que par ces proxys.
TRUST_PROXY_HOPS=1

# Verrouillage après échecs de connexion répétés (blueprint/10_Security.md §1) : une
# adresse saisie (compte existant ou non) est refusée pendant la fenêtre dès qu'elle
# cumule ce nombre d'échecs ; le verrou se lève de lui-même ou par un Administrateur.
# Valeurs absentes ou invalides : 5 échecs en 15 minutes.
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# CORS — origine du frontend Next.js
WEB_APP_URL=http://localhost:3000

# --- Frontend Next.js (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Revalidation du cache du site public à la publication d'une page.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me
# Parution programmée : l'API balaie à cet intervalle (secondes) les contenus dont la
# date de parution vient d'être atteinte et demande au site de revalider son cache
# (sinon la parution n'apparaît qu'à l'expiration du cache, 1 h au plus). 60 par
# défaut ; 0 désactive la surveillance. Inactive aussi sans les deux variables ci-dessus.
PUBLICATION_WATCH_INTERVAL_SECONDS=60

# --- Durées de conservation (blueprint/07_Database_Design.md §6) ---
# Intervalle, en heures, du balayage qui archive le journal d'audit de plus de 12 mois
# (déplacé dans audit_logs_archive, jamais supprimé) et supprime les messages de contact
# inactifs depuis 24 mois. 24 par défaut ; 0 désactive. Les durées elles-mêmes sont dans
# le code (elles figurent dans la politique de confidentialité).
RETENTION_SWEEP_INTERVAL_HOURS=24
