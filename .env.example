# Copier ce fichier en .env (racine) et/ou apps/api/.env selon l'outil utilisé.
# Ne jamais committer de valeurs réelles — voir blueprint/10_Security.md §4.

# --- PostgreSQL (docker-compose.yml, dev local) ---
# Port 5433 par défaut (et non 5432) pour éviter un conflit si un service
# PostgreSQL natif tourne déjà sur la machine de dev — adapter si besoin.
POSTGRES_USER=ewes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ewes
POSTGRES_PORT=5433

# --- API NestJS (apps/api) ---
DATABASE_URL="postgresql://ewes:change-me@localhost:5433/ewes?schema=public"
PORT=3001
NODE_ENV=development

# JWT — blueprint/10_Security.md §1 (access court, refresh roté et hashé)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

# Compte ADMINISTRATEUR initial créé par `npm run db:seed` (apps/api) — à
# changer avant toute recette/prod ; en attendant la désignation définitive
# par EWES (blueprint/21_Backlog_and_Session_Handoff.md §5).
SEED_ADMIN_EMAIL=admin@ewes.example
SEED_ADMIN_PASSWORD=change-me-now

# Stockage des documents privés — volume disque du VPS (blueprint/11_Document_Management_System.md §6)
PRIVATE_STORAGE_PATH=./storage/private
PUBLIC_MEDIA_PATH=./storage/public

# SMTP — fournisseur à confirmer par EWES (blueprint/21_Backlog_and_Session_Handoff.md §5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EWES <no-reply@ewes.example>"
CONTACT_NOTIFICATION_EMAIL=

# CORS — origine du frontend Next.js
WEB_APP_URL=http://localhost:3000

# --- Frontend Next.js (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
