# Variables de PRODUCTION — à copier sur le VPS en /opt/ewes/.env (chmod 600), jamais dans le dépôt.
# Lu par docker-compose.prod.yml via ops/deploy/compose.sh. Guide pas à pas (comment obtenir
# chaque valeur) : ops/deploy/README.md, étape 6.
#
# Ne mettre ni espaces, ni guillemets, ni caractères spéciaux dans les mots de passe et
# secrets : générer-les avec `openssl rand -hex 32` (lettres a-f et chiffres seulement),
# ce qui évite tout problème d'encodage dans les adresses de connexion.

# --- Domaine ---
# Nom de domaine seul, sans https:// ni barre finale. Son DNS doit pointer vers le VPS.
DOMAIN=ewes.example

# --- PostgreSQL ---
# Rôle propriétaire (migrations, sauvegardes) : openssl rand -hex 24
POSTGRES_PASSWORD=
# Rôle d'exécution de l'API, distinct du précédent : openssl rand -hex 24
DB_APP_PASSWORD=

# --- Secrets de l'API (32 caractères minimum, tous différents) : openssl rand -hex 32 ---
# L'API refuse de démarrer en production si l'un d'eux manque, est d'exemple ou identique à un autre.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Partagé entre l'API et le site pour l'invalidation du cache.
REVALIDATE_SECRET=

# --- Compte Administrateur initial (utilisé une seule fois par l'amorçage) ---
# Mot de passe : 12 caractères minimum, sans « change-me » ni « example ».
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- E-mail (SMTP) : fournisseur à confirmer par EWES (blueprint/21 §5) ---
# Sans SMTP_HOST, aucun e-mail ne part (contact, invitations, réinitialisations).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EWES <no-reply@ewes.example>"
# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_NOTIFICATION_EMAIL=
