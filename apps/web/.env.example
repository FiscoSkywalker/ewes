# Copier ce fichier en apps/web/.env — voir blueprint/10_Security.md §4 (aucun secret committé).

# URL publique de l'API NestJS, utilisée aussi bien côté client que par les
# routes BFF (app/api/...) qui proxient les appels d'authentification.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Durée de vie (secondes) des cookies httpOnly de session admin — doit rester
# alignée sur JWT_REFRESH_EXPIRES_IN de apps/api/.env (par défaut 7d = 604800s).
# Le cookie du jeton d'ACCÈS est volontairement conservé aussi longtemps que
# celui du jeton de rafraîchissement : le middleware Next.js ne vérifie que sa
# présence (garde de premier niveau, blueprint/10_Security.md §5) — c'est
# NestJS qui rejette un jeton d'accès expiré, avec rotation silencieuse côté
# client (voir src/lib/api/admin-fetch.ts).
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
