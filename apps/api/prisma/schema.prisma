// Schéma de données EWES — voir blueprint/07_Database_Design.md pour les
// conventions et invariants. Rôle modélisé en enum plutôt qu'en table
// dynamique : blueprint/09_Business_Rules.md §5 fixe une liste fermée de
// 3 rôles, une table dédiée ajouterait de la complexité sans besoin réel
// (principe de sobriété, blueprint/00_Project_Blueprint.md §5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATEUR
  GESTIONNAIRE
  UTILISATEUR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  ACTUALITE
  EVENEMENT
  FORMATION
  COMMUNIQUE
  ENQUETE
  PUBLICATION
}

enum DocumentCategory {
  REPORT
  GUIDE
  DATASHEET
  BROCHURE
  CERTIFICATE
}

/// Précision de la date affichée d'un article (une enquête de 2025 s'affiche « 2025 »).
enum DatePrecision {
  YEAR
  MONTH
  DAY
}

enum ConfidentialityLevel {
  PUBLIC_INTERNE
  RESTREINT
  CONFIDENTIEL
}

enum DocumentLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum ContactMessageStatus {
  NOUVEAU
  TRAITE
}

// --- Identité (blueprint/07_Database_Design.md §2 "Identité") ---

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  folderAccessGrants   FolderAccessGrant[]
  documentAccessGrants DocumentAccessGrant[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  notifications        Notification[]
  mediaUploads         Media[]
  privateUploads       PrivateDocument[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// --- Contenu institutionnel ---

/// En-tête d'une page du site public : titre (h1), introduction et description pour les moteurs de recherche.
model Page {
  id                String        @id @default(uuid())
  slug              String        @unique
  titleFr           String
  titleEn           String?
  contentFr         String
  contentEn         String?
  metaDescriptionFr String?
  metaDescriptionEn String?
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("pages")
}

model Service {
  id            String        @id @default(uuid())
  slug          String        @unique
  nameFr        String
  nameEn        String?
  taglineFr     String?
  taglineEn     String?
  descriptionFr String
  descriptionEn String?
  /// Visuel du pôle : adresse d'une image de la médiathèque (`/uploads/<nom>`) ; absent = visuel d'origine du site.
  imageUrl      String?
  imageAltFr    String?
  imageAltEn    String?
  sortOrder     Int           @default(0)
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offerings    ServiceOffering[]
  realisations Realisation[]
  documents    PublicDocument[]
  experts      Expert[]

  @@map("services")
}

/// Prestation détaillée d'un service ; suit le statut de publication de son service.
model ServiceOffering {
  id            String   @id @default(uuid())
  serviceId     String
  titleFr       String
  titleEn       String?
  descriptionFr String
  descriptionEn String?
  /// Pictogramme choisi dans la liste du site (ex. `droplets`) ; absent = pictogramme par défaut.
  icon          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_offerings")
}

/// D'où vient la valeur affichée d'un chiffre clé.
enum KeyFigureSource {
  /// Nombre saisi à la main.
  FIXED
  /// Années écoulées depuis `sinceYear`, recalculées à chaque lecture.
  YEARS_SINCE
  /// Nombre de réalisations publiées, compté en direct.
  MISSIONS
  /// Nombre de réalisations publiées de type Formation, compté en direct.
  TRAININGS
}

/// Chiffre clé de la page À propos : une valeur, son suffixe, son libellé et un sous-texte, en FR/EN.
model KeyFigure {
  id        String          @id @default(uuid())
  value     Int             @default(0)
  source    KeyFigureSource @default(FIXED)
  /// Année de départ de la source YEARS_SINCE (la valeur affichée est l'écart avec l'année courante) ; vide pour les autres sources. `value` n'est lue que pour FIXED.
  sinceYear Int?
  suffixFr  String?
  suffixEn  String?
  labelFr   String
  labelEn   String?
  subtextFr String?
  subtextEn String?
  sortOrder Int             @default(0)
  /// Masqué, le chiffre est conservé mais n'est pas affiché sur le site.
  isVisible Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("key_figures")
}

model Expert {
  id        String   @id @default(uuid())
  fullName  String
  roleFr    String
  roleEn    String?
  bioFr     String?
  bioEn     String?
  photoUrl  String?
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@map("experts")
}

// --- Réalisations (blueprint/12_Realisations_Portfolio_System.md) ---

model Realisation {
  id             String        @id @default(uuid())
  slug           String        @unique
  titleFr        String
  titleEn        String?
  clientName     String?
  isClientPublic Boolean       @default(false)
  location       String?
  year           Int?
  yearEnd        Int?
  projectType    String?
  descriptionFr  String?
  descriptionEn  String?
  objectivesFr   String?
  objectivesEn   String?
  resultsFr      String?
  resultsEn      String?
  status         ContentStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  publishedAt    DateTime?
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  images    RealisationImage[]
  documents RealisationDocument[]
  partners  RealisationPartner[]

  @@index([serviceId, status, publishedAt])
  @@map("realisations")
}

model RealisationImage {
  id            String      @id @default(uuid())
  realisationId String
  realisation   Realisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  url           String
  altFr         String?
  altEn         String?
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([realisationId])
  @@map("realisation_images")
}

model RealisationDocument {
  id               String         @id @default(uuid())
  realisationId    String
  realisation      Realisation    @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  publicDocumentId String
  publicDocument   PublicDocument @relation(fields: [publicDocumentId], references: [id], onDelete: Cascade)
  position         Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([realisationId, publicDocumentId])
  @@map("realisation_documents")
}

model RealisationPartner {
  id            String      @id @default(uuid())
  realisationId String
  realisation   Realisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  name          String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([realisationId])
  @@map("realisation_partners")
}

// --- Actualités & publications ---

model Article {
  id            String        @id @default(uuid())
  slug          String        @unique
  type          ArticleType
  titleFr       String
  titleEn       String?
  excerptFr     String?
  excerptEn     String?
  contextFr     String?
  contextEn     String?
  contentFr     String
  contentEn     String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  datePrecision DatePrecision @default(DAY)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  images    ArticleImage[]
  documents ArticleDocument[]

  @@index([type, status, publishedAt])
  @@map("articles")
}

model ArticleImage {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  altFr     String?
  altEn     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([articleId])
  @@map("article_images")
}

model ArticleDocument {
  id               String         @id @default(uuid())
  articleId        String
  article          Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  publicDocumentId String
  publicDocument   PublicDocument @relation(fields: [publicDocumentId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([articleId, publicDocumentId])
  @@map("article_documents")
}

/// Document public téléchargeable (rapport, guide, fiche, brochure). Le fichier
/// est stocké sous PUBLIC_MEDIA_PATH/documents ; `fileUrl` est son URL publique.
model PublicDocument {
  id            String           @id @default(uuid())
  slug          String           @unique
  titleFr       String
  titleEn       String?
  excerptFr     String?
  excerptEn     String?
  category      DocumentCategory
  year          Int?
  pages         Int?
  serviceId     String?
  service       Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status        ContentStatus    @default(DRAFT)
  publishedAt   DateTime?
  storedName    String           @unique
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  realisationLinks RealisationDocument[]
  articleLinks     ArticleDocument[]

  @@index([status, publishedAt])
  @@map("public_documents")
}

// --- Espace documentaire privé (blueprint/11_Document_Management_System.md) ---

model Folder {
  id              String               @id @default(uuid())
  name            String
  category        String
  subCategory     String?
  projectRef      String?
  year            Int?
  department      String?
  confidentiality ConfidentialityLevel @default(RESTREINT)
  parentId        String?
  parent          Folder?              @relation("FolderChildren", fields: [parentId], references: [id])
  children        Folder[]             @relation("FolderChildren")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  documents    PrivateDocument[]
  accessGrants FolderAccessGrant[]

  @@index([parentId])
  @@map("folders")
}

/// Document de l'espace privé. Le fichier est stocké sous PRIVATE_STORAGE_PATH
/// (hors de toute racine servie) et n'est jamais joignable que par la route API
/// authentifiée qui vérifie le droit à chaque requête ; `storedName` est interne.
model PrivateDocument {
  id              String                  @id @default(uuid())
  folderId        String
  folder          Folder                  @relation(fields: [folderId], references: [id])
  name            String
  description     String?
  storedName      String                  @unique
  fileType        String
  fileSizeBytes   Int
  // Surcharge optionnelle de la confidentialité héritée du dossier
  // (blueprint/09_Business_Rules.md §4). null = hérite du dossier.
  confidentiality ConfidentialityLevel?
  status          DocumentLifecycleStatus @default(ACTIVE)
  uploadedById    String?
  uploadedBy      User?                   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  accessGrants DocumentAccessGrant[]

  @@index([folderId])
  @@map("private_documents")
}

model FolderAccessGrant {
  id          String   @id @default(uuid())
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?
  createdAt   DateTime @default(now())

  @@unique([userId, folderId])
  @@map("folder_access_grants")
}

model DocumentAccessGrant {
  id                String          @id @default(uuid())
  privateDocumentId String
  privateDocument   PrivateDocument @relation(fields: [privateDocumentId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedById       String?
  createdAt         DateTime        @default(now())

  @@unique([userId, privateDocumentId])
  @@map("document_access_grants")
}

// --- Contact ---

/// Message du formulaire de contact. Jamais modifiable après soumission : seul
/// `status` (suivi nouveau/traité) évolue (blueprint/09_Business_Rules.md §6).
model ContactMessage {
  id            String               @id @default(uuid())
  name          String
  organization  String?
  email         String
  phone         String?
  sector        String?
  subject       String?
  message       String
  locale        String               @default("fr")
  /// Clé d'idempotence fournie par le formulaire : un renvoi de la même
  /// soumission ne crée ni doublon ni nouvelle notification.
  submissionKey String?              @unique
  /// Empreinte (email + message normalisé) : détecte un double envoi sans clé.
  contentHash   String               @default("")
  status        ContactMessageStatus @default(NOUVEAU)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([createdAt])
  @@index([email, contentHash, createdAt])
  @@map("contact_messages")
}

// --- Système ---

/// E-mail transactionnel. `idempotencyKey` rend un événement dupliqué sans
/// effet ; `payload` (sujet, texte) permet de rejouer un envoi échoué ;
/// `failedAt` + `lastError` rendent l'échec visible de l'Administrateur.
model Notification {
  id              String    @id @default(uuid())
  recipientEmail  String
  recipientUserId String?
  recipientUser   User?     @relation(fields: [recipientUserId], references: [id])
  type            String
  idempotencyKey  String?   @unique
  payload         Json?
  sentAt          DateTime?
  failedAt        DateTime?
  lastError       String?
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([recipientUserId])
  @@index([type, recipientEmail, createdAt])
  @@index([failedAt])
  @@map("notifications")
}

/// Journal d'audit en écriture seule (blueprint/09_Business_Rules.md §7) : un
/// déclencheur PostgreSQL (migration `audit_log_hardening`) interdit tout
/// UPDATE/DELETE, sauf l'anonymisation `actorId -> NULL` d'un utilisateur supprimé.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model MediaAsset {
  id            String   @id @default(uuid())
  url           String
  altFr         String?
  altEn         String?
  fileType      String
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  @@map("media_assets")
}

// --- Médias (images publiques téléversées depuis le portail) ---

/// Image publique stockée sur disque (PUBLIC_MEDIA_PATH). Le nom stocké est
/// aléatoire ; le nom d'origine n'est conservé qu'à titre indicatif.
model Media {
  id           String   @id @default(uuid())
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  originalName String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}
