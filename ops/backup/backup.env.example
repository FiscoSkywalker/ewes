# Configuration des sauvegardes — à copier vers /etc/ewes/backup.env sur le VPS
# (chmod 600, propriétaire root). Lue par backup.sh et restore.sh (BACKUP_ENV_FILE
# pour un autre emplacement). Ne contient aucun secret : le chiffrement n'utilise
# que la clé PUBLIQUE ; ne jamais y mettre de mot de passe ni de clé privée.

# Dossier des sauvegardes sur le VPS (mode 700, créé au besoin). Mettre de
# préférence sur un disque ou une partition distincte des volumes de données.
BACKUP_DIR=/var/backups/ewes

# Conteneur PostgreSQL du Docker Compose de production (docker ps --format '{{.Names}}').
BACKUP_PG_CONTAINER=ewes-postgres-1
BACKUP_PG_USER=ewes
BACKUP_PG_DB=ewes

# Chemins, SUR LE VPS, des volumes montés dans l'API sur PRIVATE_STORAGE_PATH et
# PUBLIC_MEDIA_PATH : utiliser des montages de dossier (bind mounts) dans le compose
# de production pour qu'ils soient lisibles ici. Le dossier privé contient aussi
# avatars/ et les anciens fichiers remplacés ; le dossier public contient les médias
# et les documents publics (documents/) — thumbs/ est exclu, il se reconstruit seul.
BACKUP_PRIVATE_DIR=/srv/ewes/storage/private
BACKUP_PUBLIC_DIR=/srv/ewes/storage/public

# Destinataire du chiffrement GPG : empreinte ou adresse de la clé PUBLIQUE importée
# sur le VPS (gpg --import ewes-backup-public.asc). La clé privée correspondante est
# gardée hors du serveur (voir README, section « Clé de chiffrement »).
BACKUP_GPG_RECIPIENT=

# Durée de conservation locale, en jours (entier >= 1). 30 par défaut ; la durée
# définitive est à valider avec EWES (une suppression de message de contact par la
# rétention de 24 mois reste présente dans les sauvegardes jusqu'à leur purge).
BACKUP_RETENTION_DAYS=30

# Copie hors serveur (facultatif, fortement recommandé), via rsync sur SSH :
# utilisateur@hote:/chemin/ewes-backups/ — authentification par clé SSH de root.
# La purge des anciennes copies distantes reste à la charge de la destination.
BACKUP_RSYNC_TARGET=
