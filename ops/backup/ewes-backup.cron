# Sauvegarde quotidienne EWES — à copier vers /etc/cron.d/ewes-backup (root, 644).
# 02:30 heure du serveur. Les échecs sont écrits dans le journal, dans syslog
# (étiquette ewes-backup) et dans /var/backups/ewes/status.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 2 * * * root /opt/ewes/ops/backup/backup.sh >> /var/log/ewes-backup.log 2>&1
