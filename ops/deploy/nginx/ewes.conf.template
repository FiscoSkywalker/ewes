# Nginx — reverse proxy EWES (blueprint/18_Deployment.md §2 et note du 2026-10-08).
# Modèle traité par l'image nginx (envsubst) : seule ${DOMAIN} est substituée, les
# variables Nginx ($host, $scheme…) restent intactes.
#
# Règles de ce fichier :
#  - HTTP redirige vers HTTPS (sauf le défi Let's Encrypt) ;
#  - le site Next est la seule porte d'entrée ; l'API n'est PAS exposée, à une exception
#    près : POST /api/v1/contact (le formulaire public l'appelle depuis le navigateur) ;
#  - /api/revalidate (invalidation du cache, déjà protégée par secret) n'est jamais publique ;
#  - X-Forwarded-For est complété avec $proxy_add_x_forwarded_for : l'API (TRUST_PROXY_HOPS=1)
#    et le BFF Next en retiennent la DERNIÈRE adresse, celle que Nginx vient d'ajouter.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Le plus gros fichier accepté par l'API est un document privé de 25 Mo.
    client_max_body_size 30m;

    # Résolution via le DNS interne de Docker, à chaque requête (valid=10s) : un conteneur
    # recréé par un déploiement change d'adresse, et Nginx ne doit pas garder l'ancienne.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $web_upstream http://web:3000;
    set $api_upstream http://api:3001;

    location = /api/revalidate {
        return 404;
    }

    # Seul appel direct navigateur -> API : le formulaire de contact.
    location = /api/v1/contact {
        limit_except POST {
            deny all;
        }
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $api_upstream;
    }

    location /api/v1/ {
        return 404;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $web_upstream;
    }
}
