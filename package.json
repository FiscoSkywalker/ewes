{
  "name": "ewes",
  "private": true,
  "version": "0.1.0",
  "description": "Modernisation du site web institutionnel d'EWES — voir blueprint/00_Project_Blueprint.md",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:api": "npm run lint --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "format": "npm run format --workspace=apps/web && npm run format --workspace=apps/api",
    "format:check": "npm run format:check --workspace=apps/web && npm run format:check --workspace=apps/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  }
}
